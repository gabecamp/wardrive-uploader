// Let members of the "netdev" group ask NetworkManager for Wi-Fi scans
// (needed by Wardrive Uploader's Linux scanner when it runs as a user service).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.NetworkManager.wifi.scan" &&
        subject.isInGroup("netdev")) {
        return polkit.Result.YES;
    }
});
